# Smart Meble Panel - PRODUCTION ENV
# Copy this file to config/.env and fill with real values

# MySQL
DB_HOST=localhost
DB_NAME=smartmeble
DB_USER=sm_user
DB_PASS=strong_password_here
DB_CHARSET=utf8mb4

# Security
APP_KEY=please_replace_with_long_random_string

# Public URL
BASE_URL=https://panel.smartmeble.pl

# SMTP (home.pl)
SMTP_HOST=smtp.home.pl
SMTP_PORT=587
SMTP_USER=powiadomienia@smartmeble.pl
SMTP_PASS=your_smtp_password_here
SMTP_FROM=powiadomienia@smartmeble.pl
SMTP_FROM_NAME=Smart Meble

# Uploads
UPLOAD_MAX_MB=30
